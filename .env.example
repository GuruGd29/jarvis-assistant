# Jarvis settings. install.sh writes .env for you from your answers; to do it by hand, copy this file to .env.
# Never commit .env. After changing it: bin/apply-settings.sh, then restart Jarvis
# (server: sudo systemctl restart jarvis-hermes jarvis-web; Mac: hermes gateway restart, and restart the app server).
# Write values without quotes. A setting left out uses the default shown.

# ---- You and where you live ----
# Your first name, used in greetings ("Good morning, Priya"). Empty: no name.
JARVIS_OWNER_NAME=
# Language_COUNTRY for how numbers, money and dates are written: en_IN (India: ₹1,50,000.00, 5/12 = 5 December),
# en_US (USA: $150,000.00, 5/12 = May 12), en_GB, de_DE, fr_FR, ja_JP... Default: this computer's region.
JARVIS_LOCALE=en_US
# ISO currency code for money totals: INR, USD, EUR, GBP, AED, SGD... Default: the currency of JARVIS_LOCALE's country.
JARVIS_CURRENCY=
# Time zone for reminders, the morning brief and "today". Default: this computer's time zone.
JARVIS_TIMEZONE=
# The languages you write to Jarvis in; it replies in the language of each message. Default: JARVIS_LOCALE's language.
JARVIS_LANGUAGES=English

# ---- Notifications ----
# An email address the push services (Apple, Google, Mozilla) can contact about notifications. It is sent only to
# them, never shown to anyone. Empty: the project's page is used instead.
JARVIS_CONTACT_EMAIL=

# ---- iPhone Reminders (Mac only) ----
# on: Jarvis reads the Reminders app on this Mac (your iPhone Reminders through iCloud), read-only. macOS asks once.
JARVIS_APPLE_REMINDERS=off

# ---- Money from bank alert emails (docs/money.md) ----
# Emails from banks without a built-in reader are read by the local AI: nightly (default; the AI is busy for a few
# minutes at 2:15), always (on every 30-minute sync; slower chats on a CPU server while it reads), or off.
JARVIS_MONEY_AI=nightly

# ---- Database (install.sh sets these) ----
JARVIS_DB_PASSWORD=change-me
# 5432 for Postgres installed by install.sh; 5433 for the Docker Postgres in docker-compose.yml (Mac).
JARVIS_DB_PORT=5432
# JARVIS_DB_HOST=127.0.0.1
# JARVIS_DB_NAME=jarvis
# JARVIS_DB_USER=jarvis

# ---- Models and folders (rarely changed) ----
# JARVIS_CHAT_MODEL=qwen3-4b-instruct-64k
# JARVIS_EMBED_MODEL=bge-m3
# JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# Your files: Jarvis reads and indexes everything in this folder.
# JARVIS_DATA_ROOT=~/Jarvis
# Sign-ins and other secrets (Google, iCloud, money.json); keep it private (mode 700).
# JARVIS_SECRETS_DIR=~/jarvis-system/secrets
# App server port, on 127.0.0.1 only.
# JARVIS_WEB_PORT=8791
